---
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: cls = "" } = Astro.props;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <!-- 耳朵 -->
  <path d="M17 28.5 14 9l17 9.5" />
  <path d="M47 28.5 50 9 33 18.5" />
  <!-- 头 -->
  <path d="M32 17c11 0 19 8 19 18.5S43 54 32 54 13 45 13 35.5 21 17 32 17Z" />
  <!-- 眼睛 -->
  <circle cx="24.5" cy="35" r="2.6" fill="currentColor" stroke="none" />
  <circle cx="39.5" cy="35" r="2.6" fill="currentColor" stroke="none" />
  <!-- 鼻子与嘴 -->
  <path d="M32 40.5l2.6 2.4-2.6 2.4-2.6-2.4Z" fill="currentColor" stroke="none" />
  <path d="M32 45.3v3.2M32 48.5c-2.4 0-4-1.4-4.6-3M32 48.5c2.4 0 4-1.4 4.6-3" />
  <!-- 胡须 -->
  <path d="M20 40.5 9 38.5M20.5 45 10 46M44 40.5l11-2M43.5 45l10.5 1" />
</svg>
