---
import "../styles/chibi.css";
import ThemedArt from "./ThemedArt.astro";
---
<aside id="chibi" class="chibi" data-pagefind-ignore aria-label="羽川翼的小小问候">
  <div class="chibi__bubble" id="chibi-bubble" role="status" aria-live="polite" aria-hidden="true"></div>
  <button class="chibi__figure" id="chibi-figure" type="button" aria-label="和羽川翼打招呼"><ThemedArt day="chibi-mascot-day" night="chibi-mascot-night" width={512} height={554} eager /></button>
  <button class="chibi__close" id="chibi-close" type="button" aria-label="隐藏 Q 版形象">×</button>
  <button class="chibi__open" id="chibi-open" type="button" aria-label="显示 Q 版形象"><ThemedArt day="chibi-mascot-day" night="chibi-mascot-night" width={512} height={554} /></button>
</aside>
