---
const links = [
  { href: "/", label: "首页" },
  { href: "/posts/", label: "文章" },
  { href: "/archive/", label: "归档" },
  { href: "/about/", label: "关于" },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-30 border-b" style="border-color: var(--line); background: var(--surface); backdrop-filter: blur(12px);">
  <nav class="mx-auto flex h-16 max-w-[72rem] items-center gap-6 px-6" aria-label="主导航">
    <a href="/" class="text-[15px] font-semibold no-underline" style="color: var(--text);">yu2i<span style="color: var(--sakura-deep);">.</span></a>
    <ul class="flex flex-1 items-center gap-1 text-sm">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="rounded-full px-3 py-1.5 no-underline transition-colors"
            style={path === l.href || (l.href !== "/" && path.startsWith(l.href))
              ? "color: var(--sakura-deep); background: var(--bg-alt);"
              : "color: var(--text-soft);"}
            aria-current={path === l.href ? "page" : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>
    <button
      id="theme-toggle"
      type="button"
      class="h-9 w-9 rounded-full border text-sm"
      style="border-color: var(--line); color: var(--text-soft); background: var(--surface);"
      aria-label="切换昼夜主题"
    >◐</button>
  </nav>
</header>

<script is:inline>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("yu2i-theme", dark ? "dark" : "light");
  });
</script>
