---
import type { CollectionEntry } from "astro:content";
import { formatDate, postHref } from "../utils/content";

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
---
<article class="film-card post-card group p-6">
  <p class="text-xs" style="color: var(--text-soft);">{formatDate(post.data.published)}{post.data.category && ` · ${post.data.category}`}</p>
  <h2 class="mt-2 text-lg font-semibold leading-snug">
    <a href={postHref(post)} class="no-underline" style="color: var(--text);">{post.data.title}</a>
  </h2>
  {
    post.data.description && (
      <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-soft);">{post.data.description}</p>
    )
  }
  {
    post.data.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {post.data.tags.map((t) => (
          <li class="film-tag">
            {t}
          </li>
        ))}
      </ul>
    )
  }
</article>
