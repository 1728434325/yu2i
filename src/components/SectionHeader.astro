---
import PawIcon from "./PawIcon.astro";

interface Props {
  title: string;
  href?: string;
  linkText?: string;
}
const { title, href, linkText = "查看全部" } = Astro.props;
---
<div class="mb-6 flex items-end justify-between">
  <h2 class="flex items-center gap-3 text-xl font-semibold">
    <PawIcon size={18} class="paw shrink-0" />
    {title}
  </h2>
  {href && <a href={href} class="text-sm no-underline" style="color: var(--text-soft);">{linkText} →</a>}
</div>
<style>
  .paw {
    color: var(--sakura-deep);
  }
</style>
