---
import ExpressionArt from "./ExpressionArt.astro";
import type { Expression } from "../data/artwork";
import RailCompanion from "./RailCompanion.astro";
import type { ReadingPose } from "../data/reading-art";
interface Props { title: string; href?: string; linkText?: string; expression?: Expression; companion?: ReadingPose }
const { title, href, linkText = "查看全部", expression = "smile", companion } = Astro.props;
---
<div class:list={["section-heading", { "section-heading--inhabited": companion }]}>
  <h2><ExpressionArt class="heading-sticker" expression={expression} /><span>{title}</span></h2>
  {companion && <RailCompanion pose={companion} class="section-reader" />}
  {href && <a href={href} class="section-link">{linkText}<span aria-hidden="true"> ↗</span></a>}
</div>
