---
import "../styles/global.css";
import "../styles/cinema.css";
import "../styles/reading-companions.css";
import "../styles/page-interactions.css";
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import ChibiMascot from "../components/ChibiMascot.astro";
import Footer from "../components/Footer.astro";
import ThemedArt from "../components/ThemedArt.astro";
import PixelCompanion from "../components/PixelCompanion.astro";
import { faviconVersion, expressionArt, pageExpression } from "../data/artwork";

interface Props {
  title?: string;
  description?: string;
}

const { title = "羽川翼 · yu2i", description = "一个人与一台服务器的小小世界。" } = Astro.props;
const path = Astro.url.pathname;
const showMascot = path === "/";
const pageHead = expressionArt(pageExpression(path));
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`/favicon.ico?v=${faviconVersion}`} sizes="any" />
    <link rel="icon" type="image/png" href={`/favicon-192.png?v=${faviconVersion}`} sizes="192x192" />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${faviconVersion}`} />
    <ClientRouter />
    <script is:inline>
      try {
        const param = new URLSearchParams(location.search).get("theme");
        const stored = param || localStorage.getItem("yu2i-theme");
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch {}
    </script>
  </head>
  <body class="min-h-screen" id="top" style={`--page-head-day:url("${pageHead.day.src}");--page-head-night:url("${pageHead.night.src}")`}>
    <div class="fx-layer" id="fx-bg" aria-hidden="true">
      <canvas id="fx-stars"></canvas>
      <canvas id="fx-sakura"></canvas>
    </div>
    <div id="fx-glow" aria-hidden="true"></div>
    <div id="character-cursor" aria-hidden="true"><ThemedArt eager /></div>
    <div id="click-paws" class="click-paws" aria-hidden="true" transition:persist></div>
    <div id="fx-progress" aria-hidden="true"></div>
    <Nav />
    {showMascot && <ChibiMascot />}
    <PixelCompanion />
    <slot />
    <Footer />
    <script>
      import "../scripts/theme";
      import "../scripts/effects";
      import "../scripts/wardrobe";
      import "../scripts/hero-reaction";
    </script>
  </body>
</html>
