---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import ZilingMascot from "../components/ZilingMascot.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "羽川翼 · yu2i", description = "一个人与一台服务器的小小世界。" } = Astro.props;
const path = Astro.url.pathname;
const showMascot = path === "/" || path === "/404" || path === "/404.html";
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <ClientRouter />
    <script is:inline>
      try {
        const param = new URLSearchParams(location.search).get("theme");
        const stored = param || localStorage.getItem("yu2i-theme");
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch {}
    </script>
  </head>
  <body class="min-h-screen">
    <div class="fx-layer" id="fx-bg" transition:persist aria-hidden="true">
      <canvas id="fx-stars"></canvas>
      <canvas id="fx-sakura"></canvas>
    </div>
    <div id="fx-glow" transition:persist aria-hidden="true"></div>
    <canvas id="fx-trail" class="fx-layer" transition:persist aria-hidden="true"></canvas>
    <div id="fx-progress" aria-hidden="true"></div>
    <Nav />
    {showMascot && <div transition:persist class="ziling-host"><ZilingMascot /></div>}
    <slot />
    <Footer />
    <script>
      import "../scripts/effects";
    </script>
  </body>
</html>
