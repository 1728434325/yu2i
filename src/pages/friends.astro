---
import BaseLayout from "../layouts/BaseLayout.astro";
import { friends } from "../data/friends";
---
<BaseLayout title="友链 · 羽川翼" description="一些值得看的站。">
  <main data-pagefind-body class="mx-auto max-w-[72rem] px-6 py-16">
    <h1 class="text-3xl font-[650]">友链</h1>
    <p class="mt-2 max-w-[40em] text-sm" style="color: var(--text-soft);">
      这些站给过我灵感：排版、动效、内容组织。交换友链的话，在任意文章下留言没用——这里没有评论，直接发邮件给我。
    </p>
    <ul class="mt-10 grid gap-4 md:grid-cols-2">
      {friends.map((f) => (
        <li>
          <a href={f.url} class="film-card flex items-start gap-4 no-underline" style="border-color: var(--line); background: var(--surface-solid); color: var(--text);" target="_blank" rel="noopener noreferrer">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full text-sm" style="background: var(--bg-alt); color: var(--sakura-deep);">{f.name.slice(0, 1)}</span>
            <span>
              <span class="block font-semibold">{f.name}</span>
              <span class="mt-1 block text-sm" style="color: var(--text-soft);">{f.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
