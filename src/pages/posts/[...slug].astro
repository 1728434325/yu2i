---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RailCompanion from "../../components/RailCompanion.astro";
import { formatDate } from "../../utils/content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((p) => import.meta.env.DEV || !p.data.draft)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth <= 3);
---
<BaseLayout title={`${post.data.title} · 羽川翼`} description={post.data.description}>
  <main class="mx-auto max-w-[72rem] px-6 py-16">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12">
      <article class="min-w-0">
        <header class="mb-10 border-b pb-8" style="border-color: var(--line);">
          <p class="text-xs" style="color: var(--text-soft);">
            {formatDate(post.data.published)}{post.data.category && ` · ${post.data.category}`}
          </p>
          <h1 class="mt-3 text-[clamp(1.75rem,4vw,2.75rem)] font-[650] leading-tight">{post.data.title}</h1>
          {post.data.description && <p class="mt-4 text-sm" style="color: var(--text-soft);">{post.data.description}</p>}
          {post.data.tags.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {post.data.tags.map((t) => (
                <li class="film-tag" style="border-color: var(--line); color: var(--text-soft);">{t}</li>
              ))}
            </ul>
          )}
        </header>
        <div class="prose max-w-none" style="color: var(--text);">
          <Content />
        </div>
        <nav class="reading-backlinks flex items-center justify-between border-t pt-6 text-sm" style="border-color: var(--line);" aria-label="继续阅读">
          <RailCompanion pose="lean" class="article-reader" />
          <a href="/posts/" class="no-underline" style="color: var(--text-soft);">← 全部文章</a>
          <a href="/archive/" class="no-underline" style="color: var(--text-soft);">归档 →</a>
        </nav>
      </article>
      {toc.length >= 3 && (
        <aside class="hidden lg:block">
          <nav class="sticky top-24" aria-label="目录">
            <p class="text-xs tracking-[0.15em]" style="color: var(--text-soft);">CONTENTS</p>
            <ul class="mt-3 space-y-1 text-sm">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="no-underline" style={`color: var(--text-soft); padding-left: ${(h.depth - 2) * 12}px;`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </main>
</BaseLayout>
