---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---
<BaseLayout title="项目 · 羽川翼" description="在做的事和做过的事。">
  <main data-pagefind-body class="mx-auto max-w-[72rem] px-6 py-16">
    <h1 class="text-3xl font-[650]">项目</h1>
    <p class="mt-2 text-sm" style="color: var(--text-soft);">只列真的在跑的东西，不列愿望清单。</p>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {projects.map((p) => (
        <article class="rounded-[var(--r-lg)] border p-6" style="border-color: var(--line); background: var(--surface-solid);">
          <div class="flex items-start justify-between gap-4">
            <h2 class="text-lg font-semibold">{p.name}</h2>
            <span class="shrink-0 rounded-full border px-2.5 py-0.5 text-xs" style="border-color: var(--line); color: var(--text-soft);">{p.status}</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed" style="color: var(--text-soft);">{p.summary}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {p.stack.map((s) => (
              <li class="rounded-full px-2.5 py-0.5 text-xs" style="background: var(--bg-alt); color: var(--text-soft);">{s}</li>
            ))}
          </ul>
          {p.href && <a href={p.href} class="mt-5 inline-block text-sm no-underline" style="color: var(--sakura-deep);">打开 →</a>}
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
