---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="搜索 · 羽川翼" description="站内搜索。">
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <main class="mx-auto max-w-[48rem] px-6 py-16" data-pagefind-ignore>
    <h1 class="text-3xl font-[650]">搜索</h1>
    <p class="mt-2 text-sm" style="color: var(--text-soft);">索引在构建时生成，查询在浏览器里完成——没有请求打到服务器。</p>
    <div id="search" class="mt-8"></div>
    <p class="mt-6 text-xs" style="color: var(--text-soft);">
      搜不到就去<a href="/archive/" style="color: var(--sakura-deep);">归档</a>翻一翻，按时间排的。
    </p>
  </main>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    (function () {
      function mount() {
        if (!window.PagefindUI) return;
        var ui = new PagefindUI({
          element: "#search",
          showSubResults: true,
          showImages: false,
          resetButton: true,
        });
        var q = new URLSearchParams(location.search).get("q");
        if (q) {
          var input = document.querySelector(".pagefind-ui__search-input");
          if (input) {
            input.value = q;
            input.dispatchEvent(new Event("input", { bubbles: true }));
          }
        }
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", mount, { once: true });
      } else {
        mount();
      }
      // ClientRouter 切回本页时重新挂载
      document.addEventListener("astro:page-load", function () {
        if (!document.querySelector(".pagefind-ui__search-input")) mount();
      });
    })();
  </script>
</BaseLayout>
